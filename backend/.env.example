# Backend configuration (FastAPI)

# Comma-separated list of allowed CORS origins. Use the deployed Vercel URL in
# production, e.g. https://navon-mineiq.vercel.app. "*" is fine for the demo.
CORS_ORIGINS=*

# Optional: override the location of the static demo data directory.
# DATA_DIR=/app/data

# Cloud Run sets PORT automatically; for local runs uvicorn defaults to 8080.
# PORT=8080
